{
  "info": {
    "_postman_id": "3f1c2a44-0000-4000-8000-000000000001",
    "name": "Todo App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Todos",
      "item": [
        {
          "name": "List Todos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/todos?done=false&limit=20",
              "query": [
                { "key": "done", "value": "false", "description": "Filter by completion" },
                { "key": "limit", "value": "20" },
                { "key": "debug", "value": "1", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Get Todo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/todos/:todoId" }
          }
        },
        {
          "name": "Create Todo",
          "request": {
            "method": "POST",
            "description": "Creates a new todo item",
            "header": [
              { "key": "X-Client", "value": "postman" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Buy milk\", \"priority\": 2, \"done\": false}"
            },
            "url": { "raw": "{{baseUrl}}/todos" }
          }
        }
      ]
    },
    {
      "name": "Delete Todo",
      "request": {
        "method": "DELETE",
        "url": { "raw": "https://todo.example.com/todos/:todoId" }
      }
    }
  ]
}
