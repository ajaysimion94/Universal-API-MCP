<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>com.mcpserver</groupId>
    <artifactId>mcp-server</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>mcp-server</name>
    <description>Enterprise MCP Server</description>

    <properties>
        <!-- Compile to the Java 17 LTS bytecode/API baseline. The resulting JAR runs on
             Java 17 and newer runtimes, including Java 20 and Java 21. -->
        <java.version>17</java.version>
        <node.version>v24.12.0</node.version>
        <npm.version>11.16.0</npm.version>
        <frontend.dir>${project.basedir}/webui</frontend.dir>
        <frontend.build.dir>${frontend.dir}/dist</frontend.build.dir>
        <!-- Skip downloading/bundling model + native libs + searxng source (-Dskip.bundle=true).
             The jar then relies on files already extracted on disk (dev loops only). -->
        <skip.bundle>false</skip.bundle>
        <bundled.dir>${project.build.outputDirectory}/bundled</bundled.dir>
        <sqlite-vec.version>0.1.9</sqlite-vec.version>
        <sqlite-vec.base>https://github.com/asg017/sqlite-vec/releases/download/v${sqlite-vec.version}/sqlite-vec-${sqlite-vec.version}-loadable</sqlite-vec.base>
        <!-- Pinned SearXNG source snapshot (same commit as the previously tested checkout) -->
        <searxng.ref>a6438586a5bf7e3657c4208d07296c883cd0f06d</searxng.ref>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.modelcontextprotocol.sdk</groupId>
                <artifactId>mcp-bom</artifactId>
                <version>2.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MCP Java SDK — real MCP protocol endpoint (Streamable HTTP servlet transport
             mounted on the app's own Tomcat; no Spring AI). Touched ONLY by mcp/ package.
             mcp-json-jackson2 keeps the SDK on Boot's Jackson 2 (the `mcp` aggregator would
             pull Jackson 3); the servlet transports ship inside mcp-core. -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- SQLite JDBC — embedded chunk store (zero-install across macOS/Linux/Windows).
             Bundles native SQLite per-platform in-jar (FTS5 included). sqlite-vec is fetched
             on demand as a loadable extension by the SqliteVecStorePlugin. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.3</version>
        </dependency>

        <!-- In-process ONNX Runtime for embeddings (nomic-embed-text-v1.5) -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.22.0</version>
        </dependency>

        <!-- HuggingFace tokenizer (DJL) for nomic tokenization -->
        <dependency>
            <groupId>ai.djl.huggingface</groupId>
            <artifactId>tokenizers</artifactId>
            <version>0.30.0</version>
        </dependency>

        <!-- YAML flavor of Jackson — OpenAPI specs are often YAML (version from Boot's BOM) -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- Apache Tika for binary document text extraction (PDF, Word, Excel, PowerPoint, etc.) -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>2.9.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>2.9.4</version>
        </dependency>

        <!-- Caffeine in-process cache (Phase 3 — §9) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Spring Boot Actuator + Micrometer Prometheus (Phase 3 — §10 metrics) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Standalone (shaded) build avoids classpath collisions with the app's own Tomcat —
                 used to stub Confluence/Jira Cloud + Server/DC APIs in connector tests. -->
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.9.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>mcp-server</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- Build the React SPA and copy its dist/ into the JAR's static resources.
                 Skippable with -Dskip.frontend=true for fast backend loops. -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.1</version>
                <configuration>
                    <workingDirectory>${frontend.dir}</workingDirectory>
                    <!-- Keep node out of target/ so `mvn clean` doesn't force a re-download -->
                    <installDirectory>${frontend.dir}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${node.version}</nodeVersion>
                            <npmVersion>${npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci --include=dev</arguments>
                            <!-- devDependencies (vite, tsc) are required to build; override any
                                 machine-level NODE_ENV=production that would prune them -->
                            <environmentVariables>
                                <NODE_ENV>development</NODE_ENV>
                            </environmentVariables>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Bundle the embedding model, per-platform sqlite-vec libs, and the SearXNG
                 source snapshot into the JAR so a fresh machine needs zero runtime downloads.
                 Downloads are sha256-verified and cached outside target/ (survives mvn clean).
                 Skippable with -Dskip.bundle=true for fast backend loops. -->
            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <configuration>
                    <skip>${skip.bundle}</skip>
                    <cacheDirectory>${settings.localRepository}/.cache/mcp-server-bundle</cacheDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>bundle-nomic-model</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>https://huggingface.co/nomic-ai/nomic-embed-text-v1.5/resolve/main/onnx/model_quantized.onnx</url>
                            <outputDirectory>${bundled.dir}/model</outputDirectory>
                            <outputFileName>model_quantized.onnx</outputFileName>
                            <sha256>b4342336debaea79de872370664b0aaeb67dea4605513d00ee236ea871a81f27</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-nomic-tokenizer</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>https://huggingface.co/nomic-ai/nomic-embed-text-v1.5/resolve/main/tokenizer.json</url>
                            <outputDirectory>${bundled.dir}/model</outputDirectory>
                            <outputFileName>tokenizer.json</outputFileName>
                            <sha256>d241a60d5e8f04cc1b2b3e9ef7a4921b27bf526d9f6050ab90f9267a1f9e5c66</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-sqlite-vec-macos-aarch64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${sqlite-vec.base}-macos-aarch64.tar.gz</url>
                            <unpack>true</unpack>
                            <outputDirectory>${bundled.dir}/sqlite-vec/macos-aarch64</outputDirectory>
                            <sha256>8282126333399ddfe98bbbcc7a1936e7252625aac49df056a98be602e46bfd29</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-sqlite-vec-macos-x86_64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${sqlite-vec.base}-macos-x86_64.tar.gz</url>
                            <unpack>true</unpack>
                            <outputDirectory>${bundled.dir}/sqlite-vec/macos-x86_64</outputDirectory>
                            <sha256>53ad76e400786515e2edcaed2f01271dda846316390b761fadbd2dcf56aa4713</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-sqlite-vec-linux-x86_64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${sqlite-vec.base}-linux-x86_64.tar.gz</url>
                            <unpack>true</unpack>
                            <outputDirectory>${bundled.dir}/sqlite-vec/linux-x86_64</outputDirectory>
                            <sha256>b959baa1d8dc88861b1edb337b8587178cdcb12d60b4998f9d10b6a82052d5d7</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-sqlite-vec-linux-aarch64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${sqlite-vec.base}-linux-aarch64.tar.gz</url>
                            <unpack>true</unpack>
                            <outputDirectory>${bundled.dir}/sqlite-vec/linux-aarch64</outputDirectory>
                            <sha256>ea03d39541e478fab5974253c461e1cb5d77742f69e40cf96e3fad5bc309a37c</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-sqlite-vec-windows-x86_64</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>${sqlite-vec.base}-windows-x86_64.tar.gz</url>
                            <unpack>true</unpack>
                            <outputDirectory>${bundled.dir}/sqlite-vec/windows-x86_64</outputDirectory>
                            <sha256>51581189d52066b4dfc6631f6d7a3eab7dedc2260656ab09ca97ab3fb8165983</sha256>
                        </configuration>
                    </execution>
                    <execution>
                        <id>bundle-searxng-source</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>https://github.com/searxng/searxng/archive/${searxng.ref}.zip</url>
                            <outputDirectory>${bundled.dir}/searxng</outputDirectory>
                            <outputFileName>searxng-src.zip</outputFileName>
                            <sha256>250b5dbf0bd545dcad4b138336b71ffe278d66d6963121ee2bb7d07242f312d1</sha256>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy the built SPA into static resources so it ships inside the runnable JAR. -->
            <plugin>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${frontend.build.dir}</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>skip-frontend</id>
            <activation>
                <property>
                    <name>skip.frontend</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-node-and-npm</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>npm-install</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>npm-build</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-frontend</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
